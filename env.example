# Copy to .env and fill in. All values are server-side only.

# Supabase (Postgres) — server-side access
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local Postgres for Docker dev
DATABASE_URL=postgresql://erp:erp@db:5432/erp_minero

# LLM providers (added from the LLM stage onward). Never expose in the frontend.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
