# Development-only image (reproducible dev environment).
# Production deployment is handled by Vercel and does NOT use this file.
FROM node:20-alpine

RUN corepack enable

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

CMD ["pnpm", "dev"]
